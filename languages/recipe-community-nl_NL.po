#. translators: 1: first name, 2: recipe title, 3: link, 4: days
#: includes/class-identity.php:111
#, php-format
msgid ""
"Hi %1$s,\n"
"\n"
"Thanks for your review of \"%2$s\". It is already online. Click this link to "
"confirm that this is your email address:\n"
"\n"
"%3$s\n"
"\n"
"The link works once and expires in %4$d days. After confirming you can "
"remove your review yourself on this device."
msgstr "Hoi %1$s,\n\nBedankt voor je beoordeling van \"%2$s\". Hij staat al online. Klik op deze link om te bevestigen dat dit jouw e-mailadres is:\n\n%3$s\n\nDe link werkt één keer en verloopt na %4$d dagen. Na het bevestigen kun je je beoordeling zelf verwijderen op dit apparaat."

#: includes/class-identity.php:113
msgid ""
"You also ticked the newsletter box. Clicking the link confirms your "
"newsletter signup too. If you did not mean to sign up, simply do not click "
"the link."
msgstr "Je hebt ook het vakje voor de nieuwsbrief aangevinkt. Met deze link bevestig je ook je nieuwsbriefaanmelding. Wil je je niet aanmelden, klik dan gewoon niet op de link."

#: includes/class-identity.php:115
msgid "Did not write this review? Ignore this email."
msgstr "Heb jij deze beoordeling niet geschreven? Negeer dan deze e-mail."

#. translators: %s: site name
#: includes/class-identity.php:135
#, php-format
msgid "Manage your reviews on %s"
msgstr "Beheer je beoordelingen op %s"

#. translators: 1: first name, 2: link
#: includes/class-identity.php:137
#, php-format
msgid ""
"Hi %1$s,\n"
"\n"
"Use this link to manage your reviews in this browser for the next 30 days:\n"
"\n"
"%2$s\n"
"\n"
"The link works once and expires in 7 days. Did not ask for this? Ignore this "
"email."
msgstr "Hoi %1$s,\n\nGebruik deze link om je beoordelingen de komende 30 dagen in deze browser te beheren:\n\n%2$s\n\nDe link werkt één keer en verloopt na 7 dagen. Niet aangevraagd? Negeer dan deze e-mail."

